# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ADMIN_EMAILS=owner@example.com

# AI providers
OPENAI_API_KEY="replace-with-openai-api-key"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-7
AI_THINKING_TYPE=adaptive
AI_EFFORT=max
AI_MAX_TOKENS=64000
AI_EMBEDDING_MODEL=text-embedding-3-large

# X OAuth and publishing capability configuration
X_CLIENT_ID=replace-with-x-client-id
X_CLIENT_SECRET=replace-with-x-client-secret
X_REDIRECT_URI=http://localhost:3000/api/x/oauth/callback
X_DEFAULT_SCOPES=tweet.read users.read offline.access like.read bookmark.read follows.read list.read
X_PUBLISHING_SCOPES=tweet.write media.write
X_ENTERPRISE_QUOTE_POST_ENABLED=false
X_ENTERPRISE_ANALYTICS_ENABLED=false
X_ENTERPRISE_STREAMS_ENABLED=false

# Server-only secrets
ENCRYPTION_KEY=replace-with-at-least-32-characters
CRON_SECRET=replace-with-cron-secret
PERSONAL_SAVE_TOKEN_PEPPER=replace-with-token-pepper
