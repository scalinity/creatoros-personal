# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CHROME_EXTENSION_ORIGINS=chrome-extension://replace-with-extension-id

# Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ADMIN_EMAILS=owner@example.com

# AI providers
OPENAI_API_KEY="replace-with-openai-api-key"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-7
AI_THINKING_TYPE=adaptive
AI_EFFORT=max
AI_MAX_TOKENS=64000
AI_EMBEDDING_MODEL=text-embedding-3-large

# X OAuth and publishing capability configuration
X_CLIENT_ID=replace-with-x-client-id
X_CLIENT_SECRET=replace-with-x-client-secret
X_REDIRECT_URI=http://localhost:3000/api/x/oauth/callback
X_DEFAULT_SCOPES=tweet.read users.read offline.access like.read bookmark.read follows.read list.read
X_PUBLISHING_SCOPES=tweet.write media.write
X_ENTERPRISE_QUOTE_POST_ENABLED=false
X_ENTERPRISE_ANALYTICS_ENABLED=false
X_ENTERPRISE_STREAMS_ENABLED=false

# Server-only secrets — generate with `openssl rand -base64 48` per slot.
# ENCRYPTION_KEY: minimum 32 characters; the value is SHA-256 derived so prefer
# at least 48 chars of high-entropy random material.
ENCRYPTION_KEY=replace-with-at-least-32-characters-of-random-entropy
# CRON_SECRET: minimum 24 characters of random material.
CRON_SECRET=replace-with-cron-secret-of-24-or-more-chars
# PERSONAL_SAVE_TOKEN_PEPPER: minimum 24 characters of random material.
PERSONAL_SAVE_TOKEN_PEPPER=replace-with-token-pepper-24-or-more-chars
# AUDIT_IP_HASH_PEPPER (optional): when set, IP addresses are HMAC-hashed instead of
# raw SHA-256 hashed in audit logs, defeating rainbow-table attacks on the IPv4 space.
AUDIT_IP_HASH_PEPPER=
