{
  "manifest_version": 3,
  "name": "CreatorOS Inspiration Saver",
  "version": "0.1.0",
  "description": "Save selected X inspiration into CreatorOS Personal with a scoped personal save token.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "action": {
    "default_title": "Save inspiration",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}